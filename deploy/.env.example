# Database and local persistence
TRINITY_DATABASE_URL=sqlite+aiosqlite:///./data/trinity.db
TRINITY_ARTIFACT_DIR=./artifacts

# API boundary. Set both in production; never commit real secrets.
TRINITY_API_KEY=replace-with-at-least-32-random-characters
TRINITY_AUTH_SECRET=replace-with-a-different-at-least-32-random-secret
TRINITY_AUTH_REQUIRED=1
TRINITY_CORS_ORIGINS=http://localhost:5173
TRINITY_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
TRINITY_BOOTSTRAP_ADMIN_PASSWORD=replace-before-first-start

# Optional shared services
TRINITY_REDIS_URL=redis://redis:6379/0
TRINITY_ARTIFACT_BACKEND=local
# For S3-compatible storage, set backend=s3 and supply bucket/credentials through the runtime secret store.
TRINITY_ARTIFACT_BUCKET=
TRINITY_ARTIFACT_PREFIX=trinity
TRINITY_S3_ENDPOINT=
TRINITY_ARTIFACT_URL_TTL=900
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Trusted external workers and optional toolchains
TRINITY_FUSION_WORKER_SECRET=replace-with-at-least-32-random-characters
TRINITY_KICAD_WORKER_SECRET=replace-with-at-least-32-random-characters
TRINITY_ENABLE_KICAD_CLI=0
TRINITY_ENABLE_FIRMWARE_BUILDS=0
TRINITY_FIRMWARE_ALLOWED_TOOLS=
TRINITY_FIRMWARE_RATE_LIMIT_PER_MINUTE=12
TRINITY_FIRMWARE_LLM_ENABLED=0
TRINITY_FIRMWARE_LLM_ENDPOINT=https://api.openai.com/v1/chat/completions
TRINITY_FIRMWARE_LLM_API_KEY=
TRINITY_FIRMWARE_LLM_MODEL=gpt-4o-mini
TRINITY_FIRMWARE_LLM_TEMPERATURE=0.1
TRINITY_FIRMWARE_LLM_MAX_TOKENS=6000
TRINITY_FIRMWARE_LLM_TIMEOUT=45
