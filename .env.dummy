# Trinity AI System - Dummy Environment Configuration
# All real-world values are sourced from this file.
# Swapping values requires zero code edits.

# LLM Configuration (Item 8: LLM link-up)
LLM_BASE_URL=http://localhost:11434/v1/chat/completions
LLM_MODEL_NAME=local-model
LLM_API_KEY=dummy-key-for-adapter-only
LLM_INTEGRATION_MD=LLM_INTEGRATION.md

# Business & Domain Details (Items 9-12)
TRINITY_COMPANY_NAME=Trinity AI Systems
TRINITY_DOMAIN=example.com
TRINITY_ADMIN_EMAIL=admin@example.com
TRINITY_SUPPORT_EMAIL=support@example.com

# User Authentication (Item 9)
TRINITY_AUTH_ENABLED=true
TRINITY_JWT_SECRET=jwt-dummy-secret-key-minimum-32-chars
TRINITY_SESSION_TIMEOUT_MINUTES=43200

# Safe Execution (Item 10)
SAFE_EXECUTION_ENABLED=true
SAFE_EXECUTION_TIMEOUT_SECONDS=300
SAFE_EXECUTION_MAX_RETRIES=3
SAFE_EXECUTION_PER_USER_LIMIT=5

# Razorpay Configuration (Item 11)
RAZORPAY_KEY_ID=rzp_test_dummy
RAZORPAY_KEY_SECRET=rzp_test_secret_dummy
RAZORPAY_WEBHOOK_SECRET=whsec_dummy
RAZORPAY_GST_RATE=18
RAZORPAY_CGST_RATE=9
RAZORPAY_SGST_RATE=9
RAZORPAY_PLAN_TRIAL=trieval-1m
RAZORPAY_PLAN_MONTHLY=trieval-pro-m
RAZORPAY_PLAN_ANNUAL=trieval-pro-y

# Trust Pages (Item 12)
TRINITY_ABOUT_TEXT=Trinity AI Systems provides electronic design automation tools for CAD, PCB, and firmware development. All outputs include verification reports and downloadable artifact files.
TRINITY_PRIVACY_POLICY=Trinity AI Systems respects user privacy and does not collect personally identifiable information without consent. All design data remains on the user's system unless explicitly shared.
TRINITY_TERMS_OF_SERVICE=These terms govern your use of Trinity AI software. By using the software, you agree to these terms. Designs remain your intellectual property.
TRINITY_DESIGN_OWNERSHIP=All designs created with Trinity AI remain the intellectual property of the creator. Trinity AI Systems does not claim ownership of user-generated content.

# Error Logging & Analytics (Item 13)
TRINITY_LOGGING_ENABLED=true
# Empty endpoint — feedback is stored in the local log only (dummy mode).
TRINITY_ANALYTICS_ENABLED=false
TRINITY_FEEDBACK_ENDPOINT=

# Eval Set (Item 14)
EVAL_DATASET_PATH=data/eval/prompts.jsonl
EVAL_RESULTS_PATH=data/eval/results.json
EVAL_SAVE_SCORES=true
EVAL_FLAG_REGRESSIONS=true

# Reference-Design Library (Item 15)
REF_DESIGN_LIBRARY_PATH=data/reference/library
REF_DESIGN_INR_PRICING_ENABLED=true
REF_DESIGN_FABS_AVAILABILITY=true