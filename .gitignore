# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/frontend/.next/
/frontend/out/
# production
/build

# native C++ (CMake/MSVC/Qt)
app/native/build/
**/CMakeCache.txt
**/CMakeFiles/
**/cmake_install.cmake
**/CTestTestfile.cmake
**/Testing/
*.obj
Trinity.exe

# python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
venv/
*.egg-info/

# runtime state — regenerated on startup, shouldn't be versioned
data/*.db
data/*.db-*
data/**/*.db
data/trinity.db
data/trinity.db-*
data/artifacts/*
data/jobs/*
data/cad/*
data/exports/*
data/temp/*
data/projects/*
!data/**/.gitkeep
!data/evaluation/*.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
