{
    "version": 3,
    "configurePresets": [
        {
            "name": "windows-debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TRINITY_WITH_QT": "OFF",
                "TRINITY_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "windows-release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "TRINITY_WITH_QT": "OFF",
                "TRINITY_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "windows-release-qt",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/release-qt",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "TRINITY_WITH_QT": "ON",
                "TRINITY_BUILD_TESTS": "ON"
            }
        },
        {
            "name": "linux-debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/debug-linux",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "TRINITY_WITH_QT": "OFF",
                "TRINITY_BUILD_TESTS": "ON"
            }
        }
    ],
    "buildPresets": [
        { "name": "windows-debug", "configurePreset": "windows-debug" },
        { "name": "windows-release", "configurePreset": "windows-release" },
        { "name": "windows-release-qt", "configurePreset": "windows-release-qt" },
        { "name": "linux-debug", "configurePreset": "linux-debug" }
    ],
    "testPresets": [
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release",
            "output": { "outputOnFailure": true }
        }
    ]
}
