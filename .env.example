# Never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MODEL_PROVIDER=openai
# Stage 4 — user's own LLM seam (keyless OpenAI-compatible endpoint).
# TRINITY_MODEL_ENDPOINT: full chat-completions URL, e.g.
#   http://localhost:11434/v1/chat/completions  (Ollama)
#   http://localhost:1234/v1/chat/completions   (LM Studio)
# TRINITY_MODEL_NAME: model id the server exposes (default: local-model).
# TRINITY_MODEL_API_KEY: optional bearer for gateways that demand any key.
# With no endpoint configured, streaming/agent surfaces degrade truthfully.
TRINITY_MODEL_ENDPOINT=
TRINITY_MODEL_NAME=
# Optional external CAD connector credentials.
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=
TRINITY_STORAGE_ROOT=./data
TRINITY_DB_PATH=
NEXT_PUBLIC_TRINITY_API_URL=http://localhost:8000/api
# Public origin, used for social preview image URLs. Without it the
# /og-image.png absolute URL resolves against localhost.
NEXT_PUBLIC_TRINITY_SITE_URL=http://localhost:3000
